<?xml version="1.0" encoding="UTF-8"?>
<rules>
	<!-- Cross-cutting tests: compounds, redirects, pipes, passthrough -->
	<test cmd="git status &amp;&amp; git diff" expect="allow"/>
	<test cmd="git status &amp;&amp; python --version" expect="deny"/>
	<test cmd="git status || git diff" expect="allow"/>
	<test cmd="git fetch origin latest &amp;&amp; git show HEAD" expect="allow"/>
	<test cmd="ls &amp;&amp; cat file.txt" expect="allow"/>
	<test cmd="git status &amp;&amp; gh run view 123" expect="deny"/>
	<test cmd="git status &amp;&amp; git diff &amp;&amp; git log" expect="allow"/>
	<test cmd="git status; git diff" expect="allow"/>
	<test cmd="cd some/folder &amp;&amp; git diff Config/DefaultEngine.ini" expect="allow"/>
	<test cmd="git log $(echo test)" expect=""/>
	<test cmd="git log | python" expect="deny"/>
	<test cmd="echo foo > file.txt" expect=""/>
	<test cmd="echo foo >> file.txt" expect=""/>
	<test cmd="sort input.txt > output.txt" expect=""/>
	<test cmd="ls > /tmp/out.txt" expect="allow"/>
	<test cmd="ls >> /tmp/out.txt" expect="allow"/>
	<test cmd="ls > /dev/null" expect="allow"/>
	<test cmd="ls > /tmp/sub/out.txt" expect="allow"/>
	<test cmd="ls 2> /tmp/err.txt" expect="allow"/>
	<test cmd="ls &amp;> /tmp/out.txt" expect="allow"/>
	<test cmd="ls &amp;>> /tmp/out.txt" expect="allow"/>
	<test cmd="ls > /etc/foo.txt" expect=""/>
	<test cmd="ls > out.txt" expect=""/>
	<test cmd="ls > /tmp/../etc/passwd" expect=""/>
	<test cmd='gh api --hostname github.com -H "Accept: application/vnd.github.raw+json" "repos/hagezi/dns-blocklists/contents/wildcard/pro.mini-onlydomains.txt" 2>/dev/null > /tmp/hagezi.txt &amp;&amp; wc -l /tmp/hagezi.txt' expect="allow"/>
	<test cmd="echo hello | grep hello" expect="allow"/>
	<test cmd="git log | head" expect="allow"/>
	<test cmd='git show 54d7aa918a94 --stat &amp;&amp; echo "---" &amp;&amp; git show 54d7aa918a94 -- path/to/file.cpp' expect="allow"/>

	<!-- Denied processes, in every spelling the enumeration approach misses. -->
	<test cmd="python --version" expect="deny"/>
	<test cmd="python3 script.py" expect="deny"/>
	<test cmd="python3.11 -c 'print(1)'" expect="deny"/>
	<test cmd="/usr/bin/python3 script.py" expect="deny"/>
	<test cmd="env python3 script.py" expect="deny"/>
	<test cmd="env FOO=1 python3 script.py" expect="deny"/>
	<test cmd="PYTHONPATH=/x python3 script.py" expect="deny"/>
	<test cmd="sudo -E python3 script.py" expect="deny"/>
	<test cmd="uv run python script.py" expect="deny"/>
	<test cmd="git status &amp;&amp; python3 script.py" expect="deny"/>
	<test cmd="git log | python3 -" expect="deny"/>
	<test cmd="echo $(python3 -c 'print(1)')" expect="deny"/>
	<test cmd="for f in *.txt; do python3 x.py; done" expect="deny"/>
	<test cmd="python3 - &lt;&lt;'PY'&#10;print(1)&#10;PY" expect="deny"/>
	<test cmd="cat pythonic.txt" expect="allow"/>
	<test cmd="ls /usr/bin/python3" expect="allow"/>

	<!-- Inline scripts are denied; the same interpreter running a FILE is not. -->
	<test cmd="node -e 'console.log(1)'" expect="deny"/>
	<test cmd="node --eval 'console.log(1)'" expect="deny"/>
	<test cmd="node -p '1+1'" expect="deny"/>
	<test cmd="/usr/local/bin/node -e '1'" expect="deny"/>
	<test cmd="echo 'console.log(1)' | node" expect="deny"/>
	<test cmd="node - &lt; script.js" expect="deny"/>
	<test cmd="ruby -e 'puts 1'" expect="deny"/>
	<test cmd="perl -e 'print 1'" expect="deny"/>
	<test cmd="perl -pe 's/a/b/' file.txt" expect="deny"/>
	<test cmd="perl -lane 'print $F[0]' file.txt" expect="deny"/>
	<test cmd="php -r 'echo 1;'" expect="deny"/>
	<test cmd="deno eval 'console.log(1)'" expect="deny"/>
	<test cmd="bun -e 'console.log(1)'" expect="deny"/>
	<test cmd="node script.js" expect=""/>
	<test cmd="node --experimental-strip-types tool.ts" expect=""/>
	<test cmd="node /home/user/.claude/setup/claude-md-budget.ts" expect=""/>
	<test cmd="ruby script.rb" expect=""/>
	<test cmd="perl script.pl" expect=""/>

	<!-- Programs that may not run, and programs that may not be handed a script.
	     Matched by resolved PROCESS NAME, so one entry covers every spelling:
	     an absolute path, an env/sudo/uv-run wrapper, a version suffix. Deny is
	     evaluated over the whole parse tree, including the constructs the allow
	     path refuses to read (command substitution, subshells, redirects):
	     otherwise a denied program would be one `$(...)` away from running. -->
	<deny>
		<rule process="python"
			message="Python is not available here. Use jq for JSON and node for scripts."/>

		<!-- node, ruby and perl themselves stay usable; this environment's own
		     hooks are `node file.ts`. What is denied is handing them a script:
		     writing a multi-page program into a shell argument, running it, then
		     rewriting the whole thing to change one line, costs more tokens than
		     the task and leaves nothing reviewable behind. Put it in a file. -->
		<rule process="node" inlineScript="true" evalFlags="-e,--eval,-p,--print"
			message="Write the script to a file and run it, or use an Edit/Write tool. Inline -e/--eval programs are unreviewable and get rewritten wholesale on every tweak."/>
		<rule process="ruby" inlineScript="true" evalFlags="-e"
			message="Write the script to a file and run it, or use an Edit/Write tool."/>
		<rule process="perl" inlineScript="true" evalFlags="-e,-E"
			message="Write the script to a file and run it, or use an Edit/Write tool."/>
		<rule process="php" inlineScript="true" evalFlags="-r"
			message="Write the script to a file and run it, or use an Edit/Write tool."/>
		<rule process="deno" inlineScript="true" evalFlags="-e,--eval" evalSubcommands="eval"
			message="Write the script to a file and run it, or use an Edit/Write tool."/>
		<rule process="bun" inlineScript="true" evalFlags="-e,--eval"
			message="Write the script to a file and run it, or use an Edit/Write tool."/>
		<rule process="tsx" inlineScript="true" evalFlags="-e,--eval"
			message="Write the script to a file and run it, or use an Edit/Write tool."/>
		<rule process="ts-node" inlineScript="true" evalFlags="-e,--eval"
			message="Write the script to a file and run it, or use an Edit/Write tool."/>
		<rule process="lua" inlineScript="true" evalFlags="-e"
			message="Write the script to a file and run it, or use an Edit/Write tool."/>
		<rule process="Rscript" inlineScript="true" evalFlags="-e"
			message="Write the script to a file and run it, or use an Edit/Write tool."/>
		<rule process="osascript" inlineScript="true" evalFlags="-e"
			message="Write the script to a file and run it, or use an Edit/Write tool."/>
	</deny>

	<!-- Rules that prompt rather than decide. Empty on purpose: everything not
	     allowed already reaches the user, so an entry here only earns its place
	     by making a specific request louder than the default prompt. -->
	<ask>
	</ask>

	<allow>
	<!-- Readonly inspection commands -->
	<rule name="ls" allowedFlags="*"/>
	<rule name="cat" allowedFlags="*"/>
	<rule name="head" allowedFlags="*"/>
	<rule name="tail" allowedFlags="*"/>
	<rule name="file" allowedFlags="*"/>
	<rule name="wc" allowedFlags="*"/>
	<rule name="stat" allowedFlags="*"/>
	<rule name="du" allowedFlags="*"/>
	<rule name="df" allowedFlags="*"/>
	<rule name="uname" allowedFlags="*"/>
	<rule name="uptime" allowedFlags="*"/>
	<rule name="sw_vers" allowedFlags="*"/>
	<rule name="arch" allowedFlags="*"/>
	<rule name="hostinfo" allowedFlags="*"/>
	<rule name="vm_stat" allowedFlags="*"/>
	<rule name="whoami" allowedFlags="*"/>
	<rule name="id" allowedFlags="*"/>
	<rule name="groups" allowedFlags="*"/>
	<rule name="pgrep" allowedFlags="*"/>
	<rule name="which" allowedFlags="*">
		<test cmd="which node" expect="allow"/>
		<test cmd="which git node python" expect="allow"/>
	</rule>
	<rule name="whereis" allowedFlags="*"/>
	<rule name="readlink" allowedFlags="*"/>
	<rule name="basename" allowedFlags="*"/>
	<rule name="dirname" allowedFlags="*"/>
	<rule name="printenv" allowedFlags="*"/>
	<rule name="shasum" allowedFlags="*"/>
	<rule name="md5" allowedFlags="*"/>
	<rule name="strings" allowedFlags="*"/>
	<rule name="hexdump" allowedFlags="*"/>
	<rule name="od" allowedFlags="*"/>
	<rule name="mdfind" allowedFlags="*"/>
	<rule name="mdls" allowedFlags="*"/>
	<rule name="locate" allowedFlags="*"/>
	<rule name="echo" allowedFlags="*"/>
	<rule name="printf" allowedFlags="*"/>
	<rule name="true" allowedFlags="*"/>
	<rule name="false" allowedFlags="*"/>
	<rule name="test" allowedFlags="*"/>
	<rule name="[" allowedFlags="*"/>
	<rule name="date" allowedFlags="*"/>
	<rule name="hostname" allowedFlags="*"/>
	<rule name="pwd" allowedFlags="*"/>
	<rule name="env" allowedFlags="*"/>
	<rule name="sort" allowedFlags="*"/>
	<rule name="uniq" allowedFlags="*"/>
	<rule name="tr" allowedFlags="*"/>
	<rule name="cut" allowedFlags="*"/>
	<rule name="diff" allowedFlags="*"/>
	<rule name="comm" allowedFlags="*"/>
	<rule name="join" allowedFlags="*"/>
	<rule name="paste" allowedFlags="*"/>
	<rule name="column" allowedFlags="*"/>
	<rule name="expand" allowedFlags="*"/>
	<rule name="unexpand" allowedFlags="*"/>
	<rule name="fold" allowedFlags="*"/>
	<rule name="fmt" allowedFlags="*"/>
	<rule name="nl" allowedFlags="*"/>
	<rule name="rev" allowedFlags="*"/>
	<rule name="tac" allowedFlags="*"/>
	<rule name="seq" allowedFlags="*"/>
	<rule name="realpath" allowedFlags="*"/>
	<rule name="cd" allowedFlags="*"/>
	<rule name="pkg-config" allowedFlags="*">
		<test cmd="pkg-config --cflags openssl" expect="allow"/>
		<test cmd="pkg-config --libs openssl" expect="allow"/>
		<test cmd="pkg-config --modversion openssl" expect="allow"/>
		<test cmd="pkg-config --list-all" expect="allow"/>
		<test cmd="pkg-config --exists libcurl" expect="allow"/>
	</rule>
	<rule name="pkgconf" allowedFlags="*">
		<test cmd="pkgconf --cflags openssl" expect="allow"/>
	</rule>
	<rule name="pkg_config" allowedFlags="*">
		<test cmd="pkg_config --libs openssl" expect="allow"/>
	</rule>
	<rule name="dig" allowedFlags="*"/>
	<rule name="base64" allowedFlags="*"/>
	<rule name="md5sum" allowedFlags="*"/>
	<rule name="sha1sum" allowedFlags="*"/>
	<rule name="sha256sum" allowedFlags="*"/>
	<rule name="sha384sum" allowedFlags="*"/>
	<rule name="sha512sum" allowedFlags="*"/>
	<rule name="b2sum" allowedFlags="*"/>
	<rule name="cksum" allowedFlags="*"/>
	<rule name="sum" allowedFlags="*"/>
	<rule name="xxd" allowedFlags="*"/>
	<rule name="jq" allowedFlags="*"/>
	<rule name="nproc" allowedFlags="*"/>
	<rule name="free" allowedFlags="*"/>
	<rule name="lscpu" allowedFlags="*"/>
	<rule name="lsblk" allowedFlags="*"/>
	<rule name="fd" allowedFlags="*"/>
	<rule name="fdfind" allowedFlags="*"/>
	<rule name="readelf" allowedFlags="*"/>
	<rule name="objdump" allowedFlags="*"/>
	<rule name="nm" allowedFlags="*"/>
	<rule name="size" allowedFlags="*"/>
	<rule name="ldd" allowedFlags="*"/>
	<rule name="ar" allowedFlags="*"/>
	<rule name="addr2line" allowedFlags="*"/>
	<rule name="rg" allowedFlags="*"/>

	<!-- yq -->
	<rule name="yq" allowedFlags="*">
		<deniedFlags>
			<flag name="-i" />
			<flag name="--in-place" />
		</deniedFlags>
	</rule>

	<!-- mount -->
	<rule name="mount" bareOnly="true">
		<test cmd="mount" expect="allow"/>
		<test cmd="mount /dev/sda1 /mnt" expect=""/>
		<test cmd="mount -t ext4 /dev/sda1 /mnt" expect=""/>
	</rule>

	<!-- find -->
	<rule name="find" allowedFlags="*">
		<test cmd="find . -name '*.go' -type f" expect="allow"/>
		<test cmd='find /home/mhaynie -type f -name "*decode*" -o -name "*parse*" 2>/dev/null | grep -i tool' expect="allow"/>
		<test cmd='find /home/mhaynie/repos/UnrealEngine -name "*.h" -type f -exec grep -l "class FSkeletalMeshSceneProxy" {} \;' expect="allow"/>
		<test cmd="find . -name '*.tmp' -exec rm {} \;" expect=""/>
		<test cmd="find . -name '*.tmp' -delete" expect=""/>
		<deniedFlags>
			<flag name="-delete" />
		</deniedFlags>
		<execFlags>
			<flag name="-exec" />
			<flag name="-execdir" />
			<flag name="-ok" />
			<flag name="-okdir" />
		</execFlags>
	</rule>

	<!-- grep -->
	<rule name="grep" allowedFlags="*">
		<test cmd="grep -ri 'TODO' src/" expect="allow"/>
	</rule>

	<!-- awk -->
	<rule name="awk,gawk,nawk,mawk" allowedFlags="*">
		<flagsWithValue>
			<flag name="-F" />
			<flag name="--field-separator" />
			<flag name="-v" />
			<flag name="--assign" />
			<flag name="-e" />
			<flag name="--source" />
		</flagsWithValue>
		<deniedFlags>
			<flag name="-f" />
			<flag name="--file" />
			<flag name="-E" />
			<flag name="-i" />
			<flag name="--include" />
			<flag name="-l" />
			<flag name="--load" />
			<flag name="-D" />
			<flag name="--debug" />
			<flag name="-o" />
			<flag name="--pretty-print" />
			<flag name="-p" />
			<flag name="--profile" />
		</deniedFlags>
		<denyArgSubstrings>
			<value>system(</value>
			<value>system (</value>
			<value>getline</value>
			<value>@include</value>
			<value>@load</value>
			<value>>></value>
			<value>>"</value>
			<value>> "</value>
			<value>|"</value>
			<value>| "</value>
		</denyArgSubstrings>
	</rule>

	<!-- ldconfig -->
	<rule name="ldconfig">
		<test cmd="ldconfig -p" expect="allow"/>
		<test cmd="ldconfig --print-cache" expect="allow"/>
		<test cmd="ldconfig" expect=""/>
		<requiredFlags>
			<flag name="-p" />
			<flag name="--print-cache" />
			<flag name="-v" />
		</requiredFlags>
	</rule>

	<!-- go -->
	<rule name="go">
		<test cmd="go version" expect="allow"/>
		<test cmd="go env GOPATH" expect="allow"/>
		<test cmd="go doc fmt" expect="allow"/>
		<test cmd="go doc fmt.Println" expect="allow"/>
		<test cmd="go doc -all fmt" expect="allow"/>
		<test cmd="go build ./..." expect=""/>
		<rule name="version" allowedFlags="*"/>
		<rule name="env" allowedFlags="*"/>
		<rule name="doc" allowedFlags="*"/>
	</rule>

	<!-- git -->
	<rule name="git">
		<test cmd="git status" expect="allow"/>
		<test cmd="git diff" expect="allow"/>
		<test cmd="git log --oneline -10" expect="allow"/>
		<test cmd="git status 2>&amp;1" expect="allow"/>
		<rule name="status" allowedFlags="*"/>
		<rule name="diff" allowedFlags="*"/>
		<rule name="log" allowedFlags="*"/>
		<rule name="show" allowedFlags="*"/>
		<rule name="fetch" allowedFlags="*"/>
		<rule name="ls-files" allowedFlags="*"/>
		<rule name="ls-tree" allowedFlags="*"/>
		<rule name="ls-remote" allowedFlags="*"/>
		<rule name="rev-parse" allowedFlags="*"/>
		<rule name="rev-list" allowedFlags="*"/>
		<rule name="describe" allowedFlags="*"/>
		<rule name="blame" allowedFlags="*"/>
		<rule name="shortlog" allowedFlags="*"/>
		<rule name="whatchanged" allowedFlags="*"/>
		<rule name="reflog" allowedFlags="*"/>
		<rule name="count-objects" allowedFlags="*"/>
		<rule name="fsck" allowedFlags="*"/>
		<rule name="verify-pack" allowedFlags="*"/>
		<rule name="cat-file" allowedFlags="*"/>
		<rule name="for-each-ref" allowedFlags="*"/>
		<rule name="name-rev" allowedFlags="*"/>
		<rule name="merge-base" allowedFlags="*"/>
		<rule name="branch">
			<test cmd="git branch -a" expect="allow"/>
			<test cmd="git branch -d feature" expect=""/>
			<allowedFlags>
				<flag name="-a" />
				<flag name="-r" />
				<flag name="-v" />
				<flag name="-vv" />
				<flag name="--list" />
				<flag name="--all" />
				<flag name="--remotes" />
				<flag name="--verbose" />
			</allowedFlags>
		</rule>
		<rule name="tag">
			<allowedFlags>
				<flag name="-l" />
				<flag name="-n" />
				<flag name="--list" />
				<flag name="--sort" />
			</allowedFlags>
		</rule>
		<rule name="remote">
			<test cmd="git remote -v" expect="allow"/>
			<test cmd="git remote show origin" expect="allow"/>
			<allowedFlags>
				<flag name="-v" />
				<flag name="--verbose" />
			</allowedFlags>
			<rule name="show" allowedFlags="*"/>
			<rule name="get-url" allowedFlags="*"/>
		</rule>
		<rule name="submodule">
			<test cmd="git submodule status" expect="allow"/>
			<test cmd="git submodule status --recursive" expect="allow"/>
			<test cmd="git submodule update --init" expect=""/>
			<rule name="status" allowedFlags="*"/>
		</rule>
		<rule name="config">
			<test cmd="git config --get user.email" expect="allow"/>
			<test cmd="git config --list" expect="allow"/>
			<test cmd="git config --local --list 2>&amp;1" expect="allow"/>
			<test cmd="git config --get-urlmatch http https://example.com" expect="allow"/>
			<test cmd="git config user.email foo@bar.com" expect=""/>
			<requiredFlags>
				<flag name="--get" />
				<flag name="--list" />
				<flag name="--get-all" />
				<flag name="--get-regexp" />
				<flag name="--get-urlmatch" />
				<flag name="--get-color" />
				<flag name="--get-colorbool" />
				<flag name="-l" />
			</requiredFlags>
		</rule>
		<rule name="replace">
			<test cmd="git replace -l 2>&amp;1" expect="allow"/>
			<test cmd="git replace --list" expect="allow"/>
			<test cmd="git replace abc123 def456" expect=""/>
			<requiredFlags>
				<flag name="-l" />
				<flag name="--list" />
			</requiredFlags>
		</rule>
		<rule name="commit-graph">
			<test cmd="git commit-graph verify" expect="allow"/>
			<test cmd="git commit-graph write" expect=""/>
			<rule name="verify" allowedFlags="*"/>
		</rule>
		<rule name="push">
			<test cmd="git push --dry-run origin main" expect="allow"/>
			<test cmd="git push -n origin main" expect="allow"/>
			<test cmd="git push origin main" expect=""/>
			<requiredFlags>
				<flag name="--dry-run" />
				<flag name="-n" />
			</requiredFlags>
		</rule>
	</rule>

	<!-- gh (GitHub CLI) -->
	<rule name="gh">
		<rule name="repo">
			<test cmd="gh repo view wow-look-at-my/go-toolchain" expect="allow"/>
			<test cmd="gh repo view wow-look-at-my/go-toolchain --json name,description" expect="allow"/>
			<test cmd="gh repo list" expect="allow"/>
			<rule name="view" allowedFlags="*"/>
			<rule name="list" allowedFlags="*"/>
		</rule>
		<rule name="issue">
			<rule name="list" allowedFlags="*"/>
			<rule name="view" allowedFlags="*"/>
			<rule name="status" allowedFlags="*"/>
		</rule>
		<rule name="pr">
			<test cmd="gh pr list" expect="allow"/>
			<test cmd="gh pr view 123" expect="allow"/>
			<test cmd="gh pr create" expect=""/>
			<rule name="list" allowedFlags="*"/>
			<rule name="view" allowedFlags="*"/>
			<rule name="status" allowedFlags="*"/>
			<rule name="diff" allowedFlags="*"/>
			<rule name="checks" allowedFlags="*"/>
		</rule>
		<rule name="release">
			<test cmd="gh release list" expect="allow"/>
			<test cmd="gh release list -R owner/repo" expect="allow"/>
			<test cmd="gh release view v1.0.0" expect="allow"/>
			<rule name="list" allowedFlags="*"/>
			<rule name="view" allowedFlags="*"/>
		</rule>
		<rule name="workflow">
			<rule name="list" allowedFlags="*"/>
			<rule name="view" allowedFlags="*"/>
		</rule>
		<rule name="run">
			<test cmd="gh run list" expect="allow"/>
			<test cmd="gh run view 123" expect="deny"/>
			<test cmd="gh run watch 123" expect="deny"/>
			<rule name="list" allowedFlags="*"/>
			<rule name="view" denyWithMessage="Use 'gh wait-ci' instead for checking CI status"/>
			<rule name="watch" denyWithMessage="Use 'gh wait-ci' instead for checking CI status"/>
		</rule>
		<rule name="search">
			<rule name="repos" allowedFlags="*"/>
			<rule name="issues" allowedFlags="*"/>
			<rule name="prs" allowedFlags="*"/>
			<rule name="commits" allowedFlags="*"/>
			<rule name="code" allowedFlags="*"/>
		</rule>
		<rule name="browse" allowedFlags="*">
			<test cmd="gh browse" expect="allow"/>
		</rule>
		<rule name="label">
			<rule name="list" allowedFlags="*"/>
		</rule>
		<rule name="cache">
			<rule name="list" allowedFlags="*"/>
		</rule>
		<rule name="gist">
			<rule name="list" allowedFlags="*"/>
			<rule name="view" allowedFlags="*"/>
		</rule>
		<rule name="api">
			<test cmd="gh api /repos/owner/repo" expect="allow"/>
			<test cmd="gh api -X POST /repos/owner/repo" expect=""/>
			<requireFlagValue default="GET">
				<flag name="-X" />
				<flag name="--method" />
				<allowed>GET</allowed>
			</requireFlagValue>
		</rule>
	</rule>

	<!-- claude CLI -->
	<rule name="claude" helpAlwaysAllowed="true">
		<test cmd="claude --version" expect="allow"/>
		<test cmd="claude --help" expect="allow"/>
		<test cmd="claude mcp list" expect="allow"/>
		<test cmd="claude mcp --help" expect="allow"/>
		<test cmd="claude mcp get server-name" expect="allow"/>
		<test cmd="claude mcp add my-server -- npx server" expect=""/>
		<test cmd="claude mcp remove my-server" expect=""/>
		<test cmd="claude plugin list" expect="allow"/>
		<test cmd="claude plugin marketplace list" expect="allow"/>
		<test cmd="claude plugin install some-plugin" expect=""/>
		<test cmd="claude config list" expect="allow"/>
		<test cmd="claude config get key" expect="allow"/>
		<test cmd="claude config set key value" expect=""/>
		<test cmd="claude plugin --help" expect="allow"/>
		<test cmd="claude hook --help" expect="allow"/>
		<test cmd="claude plugin marketplace add --help" expect="allow"/>
		<test cmd="claude whatever -h" expect="allow"/>
		<test cmd="claude hook list" expect=""/>
		<allowedFlags>
			<flag name="--version" />
			<flag name="-v" />
			<flag name="--help" />
			<flag name="-h" />
		</allowedFlags>
		<rule name="mcp">
			<allowedFlags>
				<flag name="--help" />
				<flag name="-h" />
			</allowedFlags>
			<rule name="list" allowedFlags="*"/>
			<rule name="get" allowedFlags="*"/>
		</rule>
		<rule name="plugin">
			<allowedFlags>
				<flag name="--help" />
				<flag name="-h" />
			</allowedFlags>
			<rule name="list" allowedFlags="*"/>
