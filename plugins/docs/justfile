[private]
help:
    @just --list

# Re-fetch the Docker reference the dockerfile and docker-compose skills read
# from, so a published plugin always carries current text rather than whatever
# was committed the day someone last ran this by hand.
#
# A fetch failure fails the build. Packaging a silently stale reference is the
# outcome this whole arrangement exists to avoid.
prebuild:
    cd ../.. && npx tsx .github/scripts/vendor-docker-docs/main.ts
