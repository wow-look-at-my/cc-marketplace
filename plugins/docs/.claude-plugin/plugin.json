{
  "$schema": "../../example-plugin/.claude-plugin/plugin.schema.json",
  "name": "docs",
  "description": "Corrective reference notes the model loads before touching things it reliably gets wrong from stale training data",
  "author": {
    "name": "wow-look-at-my-code"
  },
  "keywords": ["docs", "reference", "dockerfile", "docker-compose", "docker-images", "skills"],
  "agents": ["./agents/claude-code-source.md"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/build/docs"
          }
        ]
      }
    ]
  },
  "mh": {
    "include_in_marketplace": true
  }
}
