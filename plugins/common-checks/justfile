[private]
help:
    @just --list

# Re-read upstream's manifest, fetch the slopfix that carries every rule, and
# bundle the server, so a release enforces what common-checks enforces today.
# Either fetch failing fails the build: shipping a silently stale checker, or one
# with no checker at all, is what this arrangement exists to avoid.
prebuild:
    cd ../.. && npx tsx .github/scripts/vendor-common-checks/main.ts
    cd ../.. && sh .github/scripts/vendor-slopfix.sh plugins/common-checks
    cd ../.. && npx tsx --test plugins/common-checks/src/*.test.ts
    mkdir -p server
    cd ../.. && npx esbuild plugins/common-checks/src/server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=plugins/common-checks/server/server.cjs
    cp launcher.sh server/common-checks-lsp
    chmod +x server/common-checks-lsp
