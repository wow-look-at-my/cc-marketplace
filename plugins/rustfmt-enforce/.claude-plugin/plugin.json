{
	"$schema": "../../../.claude-plugin/plugin.schema.json",
	"name": "rustfmt-enforce",
	"description": "Runs rustfmt on every .rs file the assistant writes or edits, and refuses a git commit while a staged or modified .rs file is not rustfmt-clean",
	"author": {
		"name": "mhaynie"
	},
	"keywords": ["rust", "rustfmt", "format", "formatter", "hook", "posttooluse", "pretooluse", "commit"],
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/build/rustfmt-enforce"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/build/rustfmt-enforce"
					}
				]
			}
		]
	},
	"mh": {
		"include_in_marketplace": true
	}
}
