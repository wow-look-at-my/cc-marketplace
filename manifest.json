{
  "name": "no-overwrites",
  "version": "1164",
  "tag": "no-overwrites#1164",
  "pluginJson": {
    "author": {
      "name": "mhaynie"
    },
    "description": "Blocks the Write tool from overwriting existing files - forces use of Edit instead",
    "hooks": {
      "PreToolUse": [
        {
          "hooks": [
            {
              "command": "${CLAUDE_PLUGIN_ROOT}/hook.sh",
              "type": "command"
            }
          ],
          "matcher": "Write"
        }
      ]
    },
    "keywords": [
      "write",
      "edit",
      "overwrite",
      "guard",
      "hook"
    ],
    "name": "no-overwrites",
    "version": "1164"
  }
}